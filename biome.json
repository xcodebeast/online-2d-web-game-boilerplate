	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["**/*.{ts,tsx}"],
			"linter": {
				"rules": {
					"correctness": {
						"useQwikValidLexicalScope": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/client/**/*.tsx"],
			"linter": {
				"rules": {
					"correctness": {
						"noReactNativeRawText": "off"
					},
					"suspicious": {
						"noReactSpecificProps": "off"
					}
				}
			}
		},
		{
			"includes": [
				"apps/server/**/*.ts",
				"apps/client/vite.config.ts",
				"scripts/**/*.ts"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off"
					}
				}
			},
			"javascript": {
				"globals": ["Bun"]
			}
		},
		{
			"includes": ["package.json"],
			"linter": {
				"rules": {
					"nursery": {
						"noRestrictedDependencies": "off"
					}
				}
			}
		},
		{
			"includes": ["tests/**/*.ts"],
			"linter": {
