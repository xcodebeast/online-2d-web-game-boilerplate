{
	"name": "server",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "apps/server/src",
	"projectType": "application",
	"tags": [],
	"targets": {
		"build": {
			"command": "bun build apps/server/src/main.ts --target=bun --packages=external --outdir=dist/apps/server --sourcemap=external",
			"outputs": ["{workspaceRoot}/dist/apps/server"],
			"options": {
				"cwd": "{workspaceRoot}"
			}
		},
		"serve": {
			"command": "bun --env-file=apps/server/.env --watch apps/server/src/main.ts",
			"continuous": true,
			"options": {
				"cwd": "{workspaceRoot}"
			}
		},
		"docker-build": {
			"dependsOn": ["build"],
			"command": "docker build -f apps/server/Dockerfile . -t server",
			"options": {
				"cwd": "{workspaceRoot}"
			}
		},
		"lint": {
			"command": "biome check --error-on-warnings apps/server",
			"options": {
				"cwd": "{workspaceRoot}"
			}
		}
	}
}
