{
	"name": "@client/source",
	"version": "0.0.0",
	"license": "MIT",
	"scripts": {
		"dev": "bun --bun nx run-many --target=serve -p client server --parallel=2",
		"client:serve": "bun --bun nx run client:serve",
		"client:preview": "bun --bun nx run client:preview",
		"server:serve": "bun --bun nx run server:serve",
		"server:start": "bun dist/apps/server/main.js",
		"build": "bun --bun nx run-many --target=build -p client server --parallel=2",
		"docker-build": "bun --bun nx run-many --target=docker-build -p client server --parallel=2",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write .",
		"typecheck": "bun --bun tsc --noEmit -p tsconfig.json",
		"test": "bun test",
		"check": "bun run lint && bun run typecheck && bun run test && bun run build"
	},
	"private": true,
	"dependencies": {
		"@colyseus/core": "0.18.23",
		"@colyseus/schema": "5.0.42",
		"@colyseus/sdk": "0.18.8",
		"@colyseus/ws-transport": "0.18.4",
		"@radix-ui/react-avatar": "1.3.1",
		"@radix-ui/react-icons": "1.3.2",
		"@radix-ui/react-label": "2.1.17",
		"@radix-ui/react-slot": "1.5.0",
		"@radix-ui/react-switch": "1.4.1",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cors": "2.8.6",
		"express": "5.3.0",
		"lucide-react": "1.63.0",
		"next-themes": "0.4.6",
		"phaser": "4.2.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-router-dom": "7.18.5",
		"sonner": "2.0.8",
		"tailwind-merge": "3.7.0",
		"tailwindcss-animate": "1.0.7",
		"tslib": "2.8.1",
		"zustand": "5.0.16"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@tailwindcss/vite": "4.3.3",
		"@types/bun": "1.4.4",
		"@types/cors": "2.8.19",
		"@types/express": "5.0.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"nx": "24.0.2",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.5"
	},
	"packageManager": "bun@1.4.4",
	"engines": {
		"bun": ">=1.4.4"
	}
}
